# Default: normalize all text files to LF
* text=auto eol=lf

# Source
*.ts    text eol=lf
*.js    text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.sh    text eol=lf

# VS Code
*.vscodeignore text eol=lf

# Binary — never touch line endings
*.png   binary
*.svg   binary
