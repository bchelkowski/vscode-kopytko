            ].map(([cmd, kb, desc]) => (
              <tr class="bg-[#070b14] hover:bg-[#0f1923] transition-colors">
                <td class="px-4 py-2.5 text-white text-xs font-medium">{cmd}</td>
                <td class="px-4 py-2.5">
                  {kb ? <kbd class="bg-slate-800 border border-slate-600 px-1.5 py-0.5 rounded text-xs">{kb}</kbd> : <span class="text-slate-600 text-xs">—</span>}
