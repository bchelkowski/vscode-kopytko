{
  "name": "kopytko-linter",
  "version": "1.0.8",
  "description": "BrightScript linter for the Kopytko ecosystem. Use as a CLI tool or import as a library.",
  "license": "MIT",
  "author": "bchelkowski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bchelkowski/vscode-kopytko.git",
    "directory": "packages/linter"
  },
  "keywords": [
    "brightscript",
    "kopytko",
    "roku",
    "linter",
    "diagnostics",
    "static-analysis"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "kopytko-lint": "dist/bin/kopytko-lint.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "mocha",
    "lint": "eslint \"./src/**/*.ts\" --ext .ts",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "kopytko-brightscript-parser": "^1.0.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.2",
    "@types/sinon": "^21.0.1",
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "sinon": "^22.0.0",
    "source-map-support": "^0.5.21",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  }
}
