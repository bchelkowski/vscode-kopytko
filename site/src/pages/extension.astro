              ['Toggle Network Capture', '', 'Start/stop the capture proxy and the OS traffic redirect'],
              ['Clear Network Capture', '', 'Empty the captured request list'],
            ].map(([cmd, kb, desc]) => (
              <tr class="bg-[#070b14] hover:bg-[#0f1923] transition-colors">
                <td class="px-4 py-2.5 text-white text-xs font-medium">{cmd}</td>
                <td class="px-4 py-2.5">
                  {kb ? <kbd class="bg-slate-800 border border-slate-600 px-1.5 py-0.5 rounded text-xs">{kb}</kbd> : <span class="text-slate-600 text-xs">—</span>}
                </td>
                <td class="px-4 py-2.5 text-slate-400 text-xs">{desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Settings reference -->
    <section>
      <h2 class="text-2xl font-bold text-white mb-4">Settings reference</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left border border-[#1e2d4a] rounded-xl overflow-hidden">
          <thead class="bg-[#0f1923]">
            <tr>
              <th class="px-4 py-2.5 text-slate-400 font-medium">Setting</th>
              <th class="px-4 py-2.5 text-slate-400 font-medium">Type</th>
              <th class="px-4 py-2.5 text-slate-400 font-medium">Default</th>
              <th class="px-4 py-2.5 text-slate-400 font-medium">Description</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#1e2d4a]">
            {allSettings.map(s => (
              <tr class="bg-[#070b14] hover:bg-[#0f1923] transition-colors">
                <td class="px-4 py-2.5"><code class="text-cyan-300 text-xs">{s.key}</code></td>
                <td class="px-4 py-2.5 text-slate-500 text-xs font-mono">{s.type}</td>
                <td class="px-4 py-2.5 text-slate-500 text-xs font-mono">{s.default}</td>
                <td class="px-4 py-2.5 text-slate-300 text-xs">{s.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

  </div>
</Layout>
