---
import Layout from '../components/Layout.astro';
import Screenshot from '../components/Screenshot.astro';
import CodePanel from '../components/CodePanel.astro';
import extensionPkg from '../../../package.json';

const base = import.meta.env.BASE_URL;

const allSettings = [
  // Language Server
  { key: 'kopytko.languageServer.enabled', type: 'boolean', default: 'true', desc: 'Enable the BrightScript language server.' },
  { key: 'kopytko.languageServer.trace', type: 'enum', default: 'off', desc: 'LSP trace level (off / messages / verbose).' },
  // Imports
  { key: 'kopytko.imports.resolveModules', type: 'boolean', default: 'true', desc: 'Resolve @import paths from installed Kopytko npm packages.' },
  { key: 'kopytko.imports.sourceDir', type: 'string', default: '"app"', desc: 'Root directory where .brs source files live.' },
  { key: 'kopytko.imports.generatedPaths', type: 'array', default: '[]', desc: 'Glob patterns for build-generated import paths (suppresses unresolved diagnostics).' },
  { key: 'kopytko.imports.generatedModules', type: 'array', default: '[]', desc: 'Declares function names exported by specific build-generated files, so calls to them are not flagged as undefined.' },
  { key: 'kopytko.imports.siblingPatterns', type: 'array', default: '[]', desc: 'File patterns that share import scope with the active file.' },
  // Read-only paths
  { key: 'kopytko.readOnlyPaths', type: 'array', default: '[]', desc: 'Glob patterns for files to treat as read-only. Shared fallback for both formatting and linting.' },
  { key: 'kopytko.format.readOnlyPaths', type: 'array', default: '[]', desc: 'Formatter-specific read-only paths. Overrides kopytko.readOnlyPaths for formatting when set.' },
  { key: 'kopytko.lint.readOnlyPaths', type: 'array', default: '[]', desc: 'Linter-specific read-only paths. Overrides kopytko.readOnlyPaths for linting when set.' },
  // Casing
  { key: 'kopytko.casing.builtin', type: 'enum', default: 'preserve', desc: 'Casing applied to built-in function names in completions and formatting.' },
  { key: 'kopytko.casing.keyword', type: 'enum', default: 'preserve', desc: 'Casing for keywords — fallback for type/literal/logicOperator/mathOperator.' },
  { key: 'kopytko.casing.type', type: 'enum', default: '(keyword)', desc: 'Casing for type names (Integer, String, Object…).' },
  { key: 'kopytko.casing.literal', type: 'enum', default: '(keyword)', desc: 'Casing for true, false, invalid.' },
  { key: 'kopytko.casing.logicOperator', type: 'enum', default: '(keyword)', desc: 'Casing for and, or, not.' },
  { key: 'kopytko.casing.mathOperator', type: 'enum', default: '(keyword)', desc: 'Casing for mod.' },
  { key: 'kopytko.casing.userFunction', type: 'enum', default: 'preserve', desc: 'Casing for user-defined function names.' },
  { key: 'kopytko.casing.userMethod', type: 'enum', default: 'preserve', desc: 'Casing for user-defined AA method names.' },
  { key: 'kopytko.casing.method', type: 'enum', default: 'preserve', desc: 'Casing for component method names.' },
  { key: 'kopytko.casing.exact', type: 'object', default: '{}', desc: 'Per-identifier casing overrides: { "myFn": "camel-case" }.' },
  // Device Discovery
  { key: 'kopytko.deviceDiscovery.enabled', type: 'boolean', default: 'true', desc: 'Enable SSDP-based automatic Roku device discovery.' },
  { key: 'kopytko.deviceDiscovery.scanTimeout', type: 'number', default: '5000', desc: 'SSDP scan timeout in milliseconds.' },
  { key: 'kopytko.deviceDiscovery.showNotifications', type: 'boolean', default: 'true', desc: 'Show notification when a device goes online or offline.' },
  // Device Manager
  { key: 'kopytko.deviceManager.holdThresholdMs', type: 'number', default: '1000', desc: 'Remote Control: hold time (ms) before a press becomes a keydown/keyup hold.' },
  { key: 'kopytko.deviceManager.runner.pollIntervalMs', type: 'number', default: '500', desc: 'Script runner: device poll interval for launch / player-state / validation steps.' },
  { key: 'kopytko.deviceManager.runner.waitTimeoutSec', type: 'number', default: '30', desc: 'Script runner: timeout for wait_for_player_state and validate_streaming.' },
  // Lint rule overrides
  { key: 'kopytko.lint.rules.type/missing-return-type', type: 'enum', default: 'warning', desc: 'Severity override for missing return-type annotations.' },
  { key: 'kopytko.lint.rules.type/missing-param-type', type: 'enum', default: 'warning', desc: 'Severity override for missing parameter-type annotations.' },
  // Formatting passthrough
  { key: 'kopytko.format.indentSize', type: 'number', default: '4', desc: 'Formatter: spaces per indent level.' },
  { key: 'kopytko.format.verifySyntax', type: 'boolean', default: 'true', desc: 'Verify formatted output re-parses to an equivalent AST before applying it, catching formatter bugs.' },
  { key: 'kopytko.format.*', type: '...', default: '...', desc: 'All kopytko-formatter options available — see the Formatter page.' },
  // Diagnostics (Runtime Telemetry)
  { key: 'kopytko.diagnostics.outputDir', type: 'string', default: '"debug"', desc: 'Folder where diagnostics sessions are saved, each in its own timestamped subfolder.' },
  { key: 'kopytko.diagnostics.maxLivePoints', type: 'number', default: '3600', desc: 'Max in-memory samples per stream for the live view; older points stay on disk.' },
  { key: 'kopytko.diagnostics.debugConsolePort', type: 'number', default: '8080', desc: 'TCP port of the Roku debug server used for chanperf / sgnodes / texture metrics.' },
  { key: 'kopytko.diagnostics.collectors.memCpu.enabled', type: 'boolean', default: 'true', desc: 'Collect per-channel CPU and memory usage (chanperf).' },
  { key: 'kopytko.diagnostics.collectors.memCpu.intervalMs', type: 'number', default: '1000', desc: 'Polling interval for per-channel CPU/memory.' },
  { key: 'kopytko.diagnostics.collectors.nodeCounts.enabled', type: 'boolean', default: 'true', desc: 'Collect SceneGraph node counts by type.' },
  { key: 'kopytko.diagnostics.collectors.nodeCounts.intervalMs', type: 'number', default: '2000', desc: 'Polling interval for node counts.' },
  { key: 'kopytko.diagnostics.collectors.objectCounts.enabled', type: 'boolean', default: 'true', desc: 'Collect BrightScript object counts by type. Only polled while the Objects chart/table is visible (hidden by default).' },
  { key: 'kopytko.diagnostics.collectors.objectCounts.intervalMs', type: 'number', default: '2000', desc: 'Polling interval for object counts.' },
  { key: 'kopytko.diagnostics.collectors.rendezvous.enabled', type: 'boolean', default: 'true', desc: 'Collect render-thread rendezvous via ECP.' },
  { key: 'kopytko.diagnostics.collectors.rendezvous.intervalMs', type: 'number', default: '1000', desc: 'Polling interval for rendezvous events.' },
  { key: 'kopytko.diagnostics.collectors.systemMem.enabled', type: 'boolean', default: 'false', desc: 'Collect device-wide memory. Off by default; per-channel memory is usually more useful.' },
  { key: 'kopytko.diagnostics.collectors.systemMem.intervalMs', type: 'number', default: '5000', desc: 'Polling interval for device-wide memory.' },
  { key: 'kopytko.diagnostics.collectors.textures.enabled', type: 'boolean', default: 'true', desc: 'Collect GPU texture/bitmap memory. The Textures chart/table only shows when selected in the dropdowns.' },
  { key: 'kopytko.diagnostics.collectors.textures.intervalMs', type: 'number', default: '5000', desc: 'Polling interval for texture memory.' },
  { key: 'kopytko.diagnostics.collectors.appState.enabled', type: 'boolean', default: 'true', desc: 'Track app foreground/background state, shown as background shading on charts. Requires "Control by mobile apps" on the device.' },
  { key: 'kopytko.diagnostics.collectors.appState.intervalMs', type: 'number', default: '2000', desc: 'Polling interval for app state.' },
  { key: 'kopytko.diagnostics.collectors.fwBeacon.enabled', type: 'boolean', default: 'true', desc: 'Track framework beacon markers (AppLaunch/AppResume/VODStart) via ECP /fwbeacons.' },
  { key: 'kopytko.diagnostics.collectors.fwBeacon.intervalMs', type: 'number', default: '1000', desc: 'Polling interval for framework beacon events.' },
  { key: 'kopytko.diagnostics.defaultVisibleCharts', type: 'array', default: '["memory","cpu","nodes"]', desc: 'Which charts are visible by default (memory / cpu / nodes / objects / textures).' },
  { key: 'kopytko.diagnostics.defaultVisibleTables', type: 'array', default: '["nodes","rendezvous"]', desc: 'Which tables are visible by default (nodes / objects / rendezvous / textures).' },
  { key: 'kopytko.diagnostics.memoryLimits.backgroundMB', type: 'number', default: '100', desc: 'Reference line on the Memory chart for the published background-app DRAM guidance.' },
  // Perfetto (App Tracing)
  { key: 'kopytko.perfetto.ecpPort', type: 'number', default: '8060', desc: 'ECP port used for Perfetto tracing control and the WebSocket connection.' },
  { key: 'kopytko.perfetto.refreshIntervalMs', type: 'number', default: '3000', desc: 'How often the live trace buffer pushed to the webview is coalesced and flushed. The on-disk trace file is written per-chunk regardless.' },
  { key: 'kopytko.perfetto.startCommand', type: 'string', default: '""', desc: 'Build and deploy command for Perfetto sessions. Defaults to npx kopytko start when empty.' },
  { key: 'kopytko.network.proxyPort', type: 'number', default: '8888', desc: 'Local port the Network Inspector capture proxy listens on. Device traffic is redirected here.' },
  { key: 'kopytko.network.redirectPorts', type: 'number[]', default: '[80]', desc: 'Device-side ports whose traffic is transparently redirected into the capture proxy (HTTP only).' },
  { key: 'kopytko.network.maxEntries', type: 'number', default: '5000', desc: 'Maximum captured requests kept in memory before the oldest are dropped.' },
  { key: 'kopytko.network.maxBufferBytes', type: 'number', default: '52428800', desc: 'Approximate memory budget in bytes for retained flows (bodies + overhead). Oldest requests are evicted when exceeded; 0 disables the byte cap.' },
  { key: 'kopytko.network.upstreamKeepAlive', type: 'boolean', default: 'true', desc: 'Reuse proxy→origin connections (HTTP keep-alive) instead of a fresh TCP/TLS handshake per request. The device-side connection always closes per request. A pooled connection that goes stale mid-request is retried once automatically on a fresh connection; disable only if an origin still misbehaves with reuse.' },
  { key: 'kopytko.network.filterToActiveDevice', type: 'boolean', default: 'true', desc: "Only show traffic from the active Roku device's IP (hides the dev machine's own traffic)." },
  { key: 'kopytko.network.maxBodyBytes', type: 'number', default: '262144', desc: 'Max body bytes retained in memory per request for inline display/HAR. The full body is always forwarded to the device and persisted uncapped to the capture session folder.' },
  { key: 'kopytko.network.outputDir', type: 'string', default: '"debug"', desc: 'Folder (workspace-relative or absolute) where capture sessions are saved — manifest, flows.ndjson, and full request/response body files per session.' },
  { key: 'kopytko.network.defaultUpstreamScheme', type: 'enum', default: '"https"', desc: 'Scheme the proxy uses to reach an origin the device called over HTTP. https bridges to a secure upstream connection.' },
  { key: 'kopytko.network.rewriteRules', type: 'object[]', default: '[]', desc: 'Body rewrite rules for text bodies (host and path scoped). When empty, the built-in https:// → http:// and wss:// → ws:// response rules are used.' },
  { key: 'kopytko.network.rewriteExcludeRules', type: 'object[]', default: '[]', desc: 'Host+path pairs opted out of ALL body rewriting (every enabled rule, both directions, even the built-ins) — for a response that must reach the device byte-for-byte.' },
  { key: 'kopytko.network.upstreamSchemes', type: 'object[]', default: '[]', desc: 'Per-host upstream scheme overrides ({ hostPattern, scheme }).' },
  { key: 'kopytko.network.mapLocalRules', type: 'object[]', default: '[]', desc: 'Serve a local file or inline body instead of contacting the upstream on host/path match.' },
  { key: 'kopytko.network.latencyRules', type: 'object[]', default: '[]', desc: 'Delay matched responses by delayMs before sending them to the device.' },
  { key: 'kopytko.network.headerRules', type: 'object[]', default: '[]', desc: 'Add/set/remove request or response headers for matched hosts (proxy-owned headers are protected).' },
  { key: 'kopytko.network.blockRules', type: 'object[]', default: '[]', desc: 'Abort matched requests (connection reset) to test the channel\'s network-error handling.' },
  { key: 'kopytko.network.breakpointRules', type: 'object[]', default: '[]', desc: 'Pause matched request/response so you can edit it live before continuing.' },
  { key: 'kopytko.network.breakpointTimeoutMs', type: 'number', default: '30000', desc: 'Auto-continue a paused breakpoint after this long, so a forgotten one can\'t hang the device.' },
  { key: 'kopytko.network.winDivertDir', type: 'string', default: '""', desc: 'Windows only, usually unnecessary — a working WinDivert driver ships with the extension. Override folder with WinDivert.dll/WinDivert64.sys; machine-scoped, cannot be set via workspace settings.' },
];

const importExample = `' @import /components/VideoPlayer.brs
' @import /utils/analytics.brs
' @mock  /components/VideoPlayer.brs  ' test mode only

sub init()
  ' completions, hover, go-to-definition all work
  m.player = createVideoPlayer()
  m.player.observeFieldScoped("state", "onStateChanged")
end sub`;

const snippetsExample = `' Type "it" + Tab for a test case snippet:
it("should initialize correctly", sub()
  m.player = VideoPlayer()
  expect(m.player.isReady).toBe(true)
end sub)

' Type "expect" for matcher completions:
expect(result).toBe(42)
expect(result).toEqual({ id: 1 })
expect(m.mock).toHaveBeenCalled()`;

const debugLaunchConfig = `// .vscode/launch.json
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "brightscript",
      "request": "launch",
      "name": "Debug on Roku",

      // host and password are OPTIONAL.
      // When omitted they are taken from the active device in the sidebar.
      // "host": "192.168.1.100",
      // "password": "rokudev",

      "rootDir": "\${workspaceFolder}",

      // env selects a .kopytkorc environment key ("dev", "staging", ...).
      // Optional — taken from the active device's environment selection if omitted.
      // "env": "dev",

      "stopOnEntry": false
    }
  ]
}`;

const kopytkoRcExample = `// .kopytkorc
{
  "baseManifest": "app/manifest",
  "sourceDir": "app",
  "archivePath": "/dist/my_app_\${args.env}.zip",

  "environments": {
    "dev": {
      "manifest": "app/manifests/dev.manifest",
      "plugins": ["dev-tools-plugin"]
    },
    "staging": {
      "manifest": "app/manifests/staging.manifest"
    },
    "production": {
      "manifest": "app/manifests/prod.manifest",
      "plugins": ["minify-plugin"]
    }
  }
}`;
---
<Layout title="Extension" activePage="extension">
  <!-- Page header -->
  <div class="bg-[radial-gradient(ellipse_60%_40%_at_50%_0%,rgba(124,58,237,0.12),transparent)] border-b border-[#1e2d4a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="flex items-center gap-2 text-sm text-slate-500 mb-4">
        <span>VS Code Marketplace</span>
        <span>/</span>
        <code class="text-slate-300">bchelkowski.kopytko</code>
        <span class="bg-slate-700/60 text-slate-400 text-xs px-2 py-0.5 rounded-full ml-1">v{extensionPkg.version}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4">Kopytko VS Code Extension</h1>
      <p class="text-lg text-slate-400 max-w-2xl leading-relaxed">
        A full-featured BrightScript language server extension for VS Code. IntelliSense, diagnostics, go-to-definition, call hierarchy, formatting, debugging, and Roku device management — all in one.
      </p>
      <div class="flex flex-wrap gap-3 mt-6">
        <a href="https://marketplace.visualstudio.com/items?itemName=bchelkowski.vscode-kopytko" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 bg-[#0078d4] hover:bg-[#006bbf] text-white text-sm font-medium rounded-lg transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M23.15 2.587L18.21.21a1.494 1.494 0 0 0-1.705.29l-9.46 8.63-4.12-3.128a.999.999 0 0 0-1.276.057L.327 7.261A1 1 0 0 0 .326 8.74L3.899 12 .326 15.26a1 1 0 0 0 .001 1.479L1.65 17.94a.999.999 0 0 0 1.276.057l4.12-3.128 9.46 8.63a1.492 1.492 0 0 0 1.704.29l4.942-2.377A1.5 1.5 0 0 0 24 20.06V3.939a1.5 1.5 0 0 0-.85-1.352zm-5.146 14.861L10.826 12l7.178-5.448v10.896z"/></svg>
          Marketplace
        </a>
        <a href="https://github.com/bchelkowski/vscode-kopytko" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 bg-white/5 hover:bg-white/10 border border-white/10 text-slate-200 text-sm font-medium rounded-lg transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          Source
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-20">

    <!-- IntelliSense -->
    <section>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
        <div>
          <h2 class="text-2xl font-bold text-white mb-3">IntelliSense</h2>
          <p class="text-slate-400 leading-relaxed mb-4">
            Context-aware completions covering every BrightScript built-in, user-defined functions, local variables, type annotations, ro* component constructors, and Kopytko module exports.
          </p>
          <ul class="space-y-2 text-sm">
            {[
              'Built-in functions and keywords from the BrightScript stdlib',
              'User functions from current file, @imports, XML siblings, and /source/',
              'Local variables, parameters, and for-loop variables',
              'CreateObject("...") — SceneGraph component name completions',
              'Type inference: member completions after CreateObject() or typed params',
              'm.top field completions from XML interface and parent SG components',
              '@import / @mock path auto-complete with package-resolution',
              'Kopytko module exports — auto-inserts @import on selection',
              'Test framework completions: expect(), mockFunction(), test globals',
            ].map(item => (
              <li class="flex items-start gap-2.5 text-slate-300">
                <span class="text-violet-400 mt-0.5 shrink-0">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="space-y-4">
          <Screenshot
            alt="IntelliSense completion popup"
            placeholder="Completion popup showing BrightScript built-ins, user functions, and type-inferred members"
          />
          <Screenshot
            alt="Hover documentation"
            placeholder="Hover card on a built-in function showing its signature, description, and return type"
          />
        </div>
      </div>
    </section>

    <!-- Navigation -->
    <section>
      <h2 class="text-2xl font-bold text-white mb-3">Navigation</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <div>
          <p class="text-slate-400 leading-relaxed mb-4">
            Navigate your codebase with precision — from go-to-definition on @import paths to workspace-wide call hierarchy. All navigation respects the @import graph and XML sibling relationships.
          </p>
          <div class="grid grid-cols-2 gap-3">
            {[
              { label: 'Go-to-Definition', desc: '@import paths, user functions, /source/ functions' },
              { label: 'Find All References', desc: 'Workspace-wide with Shift+F12' },
              { label: 'Call Hierarchy', desc: 'Incoming and outgoing calls (Shift+Alt+H)' },
              { label: 'Outline / Symbols', desc: 'Functions, subs, and AA methods with params' },
              { label: 'Workspace Symbols', desc: 'Fuzzy search across all .brs files (Ctrl+T)' },
              { label: 'Document Links', desc: 'Clickable @import paths' },
              { label: 'Folding Ranges', desc: 'CST-driven folds for functions and @import groups' },
              { label: 'Selection Range', desc: 'Smart expand/shrink (Shift+Alt+→)' },
            ].map(n => (
              <div class="bg-[#0f1923] border border-[#1e2d4a] rounded-lg p-3">
                <div class="text-sm font-medium text-white mb-0.5">{n.label}</div>
                <div class="text-xs text-slate-500">{n.desc}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="space-y-4">
          <Screenshot
            alt="Go-to-definition on import"
            placeholder="Definition peek popup on an @import path, jumping to the imported .brs file"
          />
          <Screenshot
            alt="Call hierarchy panel"
            placeholder="Incoming calls panel showing which functions call the selected function"
          />
        </div>
      </div>
    </section>

    <!-- Diagnostics -->
    <section>
      <h2 class="text-2xl font-bold text-white mb-3">Diagnostics & Quick Fixes</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <div class="space-y-4">
          <Screenshot
            alt="BrightScript diagnostics"
            placeholder="BrightScript file with multiple diagnostic squiggles: undefined function, missing type annotation, unused import"
          />
          <Screenshot
            alt="Quick fix menu"
            placeholder="Light-bulb quick-fix menu with options: Add missing import, Remove unused parameter, Add type annotation"
          />
        </div>
        <div>
          <p class="text-slate-400 leading-relaxed mb-4">
            Real-time diagnostics powered by the <a href={`${base}/linter`} class="prose-link">kopytko-linter</a> engine. 31 rules reported as you type, with code actions for auto-fixable issues.
          </p>
          <div class="space-y-2 text-sm">
            {[
              { rule: 'identifier/undefined-function', kind: 'error', desc: 'Highlights calls to undeclared functions' },
              { rule: 'identifier/undefined-variable', kind: 'error', desc: 'Variable used before assignment' },
              { rule: 'import/unresolved', kind: 'error', desc: '@import path cannot be found on disk' },
              { rule: 'import/unused', kind: 'warning', desc: 'Imported file never referenced' },
              { rule: 'type/missing-return-type', kind: 'warning', desc: 'Missing as Type on function declaration' },
              { rule: 'callback/undefined-observer-callback', kind: 'error', desc: 'observeFieldScoped() callback not found' },
            ].map(d => (
              <div class="flex items-start gap-3">
                <span class:list={['text-xs px-1.5 py-0.5 rounded font-medium shrink-0', d.kind === 'error' ? 'badge-error' : 'badge-warning']}>{d.kind}</span>
                <div>
                  <code class="text-xs text-slate-300">{d.rule}</code>
                  <p class="text-xs text-slate-500 mt-0.5">{d.desc}</p>
                </div>
              </div>
            ))}
            <p class="text-xs text-slate-500 pt-2">… and 19 more rules. <a href={`${base}/linter`} class="prose-link">Full rule list →</a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- Kopytko imports & test support -->
    <section>
      <h2 class="text-2xl font-bold text-white mb-3">Kopytko imports & test framework</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div>
          <p class="text-slate-400 leading-relaxed mb-4">
            First-class support for the @import / @mock annotation system used by the Kopytko Framework. Import chains are resolved transitively across packages with full IntelliSense at each step.
          </p>
          <CodePanel code={importExample} />
        </div>
        <div>
          <p class="text-slate-400 leading-relaxed mb-4">
            Test files (<code class="text-violet-300">*/_tests/**/*.test.brs</code>) get enriched completions for the Kopytko Unit Testing Framework: <code class="text-violet-300">expect()</code> matchers, <code class="text-violet-300">mockFunction()</code>, and test globals with documentation.
          </p>
          <CodePanel code={snippetsExample} />
        </div>
      </div>
    </section>

