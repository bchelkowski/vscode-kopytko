---
interface Props {
  src?: string;
  alt: string;
  caption?: string;
  placeholder?: string;
  class?: string;
}

const { src, alt, caption, placeholder, class: className } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<figure class:list={['my-6', className]}>
  {src ? (
    <img
      src={`${base}/screenshots/${src}`}
      alt={alt}
      class="rounded-xl border border-[#1e2d4a] w-full shadow-2xl shadow-black/50"
      loading="lazy"
    />
  ) : (
    <div class="rounded-xl border border-dashed border-[#2d4060] bg-[#0f1923] flex flex-col items-center justify-center min-h-52 p-8 text-center">
      <svg class="w-10 h-10 text-slate-600 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <p class="text-sm text-slate-500 font-medium">{alt}</p>
      {placeholder && <p class="text-xs text-slate-600 mt-1 max-w-xs">{placeholder}</p>}
      <p class="text-xs text-slate-700 mt-3 font-mono">→ site/public/screenshots/{alt.toLowerCase().replace(/\s+/g, '-')}.png</p>
    </div>
  )}
  {caption && (
    <figcaption class="text-xs text-slate-500 text-center mt-2">{caption}</figcaption>
  )}
</figure>
