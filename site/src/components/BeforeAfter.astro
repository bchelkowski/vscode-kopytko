---
import { highlight } from '../utils/highlight';

interface Props {
  before: string;
  after: string;
  beforeLabel?: string;
  afterLabel?: string;
  lang?: string;
}

const {
  before,
  after,
  beforeLabel = 'Before',
  afterLabel = 'After',
  lang = 'brightscript',
} = Astro.props;

const [beforeHtml, afterHtml] = await Promise.all([
  highlight(before, lang),
  highlight(after, lang),
]);
---
<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
  <div>
    <div class="flex items-center gap-2 px-3 py-1.5 mb-1">
      <span class="w-2 h-2 rounded-full bg-red-500"></span>
      <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">{beforeLabel}</span>
    </div>
    <div set:html={beforeHtml} />
  </div>
  <div>
    <div class="flex items-center gap-2 px-3 py-1.5 mb-1">
      <span class="w-2 h-2 rounded-full bg-green-500"></span>
      <span class="text-xs font-medium text-slate-400 uppercase tracking-wider">{afterLabel}</span>
    </div>
    <div set:html={afterHtml} />
  </div>
</div>
