{
  "name": "kopytko-roku-device",
  "version": "1.5.0",
  "description": "Roku device communication toolkit: SSDP discovery, ECP client, SceneGraph debug console, BrightScript debug protocol, diagnostics collectors, and Perfetto tracing.",
  "license": "MIT",
  "author": "bchelkowski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bchelkowski/vscode-kopytko.git",
    "directory": "packages/roku-device"
  },
  "keywords": [
    "roku",
    "brightscript",
    "ecp",
    "ssdp",
    "scenegraph",
    "debugger",
    "diagnostics",
    "perfetto"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "kopytko-roku": "./dist/bin/kopytko-roku.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "mocha",
    "lint": "eslint \"./src/**/*.ts\" --ext .ts",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.2",
    "@types/sinon": "^21.0.1",
    "@types/ws": "^8.18.1",
    "chai": "^6.2.2",
    "eslint": "^10.5.0",
    "mocha": "^11.7.6",
    "sinon": "^22.0.0",
    "source-map-support": "^0.5.21",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  }
}
